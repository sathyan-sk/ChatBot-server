# ==============================================================
# AI Knowledge Platform - Environment Configuration (.env.example)
# Copy to .env and fill in real values. Never commit .env itself.
# ==============================================================

# --- Application ---
APP_NAME=AI Knowledge Platform
APP_ENV=development
DEBUG=true

# --- Database (Supabase Postgres + pgvector) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# --- Supabase Storage ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=knowledge-documents

# --- Security ---
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=60
API_KEY_HASH_SALT=replace-with-a-long-random-salt

# --- Provider Selection (Provider != Model) ---
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=your-openrouter-key

EMBEDDING_PROVIDER=nomic
EMBEDDING_MODEL=nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
NOMIC_API_KEY=your-nomic-key

RERANKER_PROVIDER=cross_encoder
PARSER_PROVIDER=docling
STORAGE_PROVIDER=supabase
VECTOR_SEARCH_PROVIDER=pgvector

# --- Application Defaults ---
DEFAULT_CONVERSATION_RETENTION_HOURS=720
DEFAULT_CHAT_CONTEXT_MESSAGE_LIMIT=10
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=20
DEFAULT_RERANK_TOP_N=5
DEFAULT_RATE_LIMIT_PER_MINUTE=60
INGESTION_PROCESSING_TIMEOUT_MINUTES=10

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=5
CONVERSATION_CLEANUP_INTERVAL_MINUTES=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json